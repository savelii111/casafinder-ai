{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "assistant"
      ]
    },
    "content": {
      "type": "string"
    },
    "apartments_shown": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of apartments shown in this message"
    }
  },
  "required": [
    "user_email",
    "role",
    "content"
  ]
}