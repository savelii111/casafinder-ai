{
  "name": "UserSubscription",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User email"
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "pro1",
        "pro2",
        "ultimate"
      ],
      "default": "free"
    },
    "ai_requests_today": {
      "type": "number",
      "default": 0
    },
    "last_request_date": {
      "type": "string",
      "format": "date"
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "stripe_subscription_id": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "es",
        "ru"
      ],
      "default": "en"
    }
  },
  "required": [
    "user_email"
  ]
}